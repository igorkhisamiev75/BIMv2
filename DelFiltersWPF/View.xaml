<Window x:Class="DelFiltersWPF.View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DelFiltersWPF"
             mc:Ignorable="d" 
             Title="Remove filters"
             Height="500" Width="350">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="273*"/>
            <ColumnDefinition Width="95*"/>
        </Grid.ColumnDefinitions>
        <Button Content="OK" 
                HorizontalAlignment="Left" 
                Margin="9.571,98,0,0" 
                VerticalAlignment="Top" 
                Width="75" Height="21" 
                Grid.Column="1"/>
        <Button Content="CANCEL" 
                HorizontalAlignment="Left" 
                Margin="9.571,132,0,0" 
                VerticalAlignment="Top" Width="75" 
                Grid.Column="1"/>
        <DataGrid Grid.Column="0" 
                  x:Name="DataGrid"
                  HorizontalAlignment="Left" 
                  Height="451" Margin="10,10,0,0" 
                  VerticalAlignment="Top" 
                  Width="224">
            <ListBoxItem x:Name="ListBoxItem"/>
            <CheckBox/>
        </DataGrid>
        <CheckBox Content="Unused"
                  HorizontalAlignment="Left"
                  Margin="16.667,10,0,0"
                  VerticalAlignment="Top" 
                  Grid.Column="1"/>
        <TextBox Grid.Column="1" HorizontalAlignment="Left" Height="21" Margin="9.571,45,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="69"/>

    </Grid>
</Window>
