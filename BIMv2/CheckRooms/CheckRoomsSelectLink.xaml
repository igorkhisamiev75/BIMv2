<Window x:Class="BIMv2.CheckRooms.CheckRoomsSelectLink"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BIMv2.CheckRooms"
             mc:Ignorable="d" 
             Height="500" 
             Width="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.7*"/>
            <RowDefinition Height="0.3*"/>
        </Grid.RowDefinitions>
        <Button Name="cancel"
                Grid.Row="1"
                Content="Отмена" 
                HorizontalAlignment="Right" 
                Margin="0,0,10,0" 
                VerticalAlignment="Center"                 
                Height="60" 
                Width="200" FontWeight="Bold" 
                FontSize="16" 
                Click="Button_Click"/>
        <Button Name="btnChech"
                Grid.Row="1"
                Content="Проверка помещений" 
                HorizontalAlignment="Left" 
                Margin="10,0,0,0" 
                VerticalAlignment="Center" 
                Height="60" 
                Width="210"
                FontSize="16" FontWeight="Bold" Click="btnChech_Click"/>
        <ComboBox Name="cbNameLinks"
                  Grid.Row="0"
                  HorizontalAlignment="Left" 
                  Margin="10,0,0,0" 
                  VerticalAlignment="Center" 
                  Width="482" 
                  Height="89"/>
        <Label Content="Выбрать связанную модель с помещениями "
               HorizontalAlignment="Left" 
               Margin="59,43,0,0" 
               VerticalAlignment="Top" 
               FontWeight="Bold" 
               FontSize="18" Foreground="#FFC50A0A" 
               
               />
        <Label Content="Помещений в связанной модели:" 
               HorizontalAlignment="Left" 
               Margin="10,229,0,0" 
               VerticalAlignment="Top"/>
        <Label Content="Помещений в текущей модели:" 
               HorizontalAlignment="Left" 
               Margin="10,260,0,0" 
               VerticalAlignment="Top"/>

        <Label Content="Здесь могла быть ваша реклама" 
               HorizontalAlignment="Left" 
               Margin="10,107,0,0" 
               Grid.Row="1" 
               VerticalAlignment="Top"/>
        <TextBox Name="tbRoomsinLink"
                 HorizontalAlignment="Left" 
                 Margin="222,233,0,0" 
                 TextWrapping="Wrap" 
                 Text="сколько?" 
                 VerticalAlignment="Top" 
                 Width="120"/>
        <TextBox Name="tbRoomsinCurrent"
                 HorizontalAlignment="Left" 
                 Margin="222,263,0,0" 
                 TextWrapping="Wrap" 
                 Text="" 
                 VerticalAlignment="Top" 
                 Width="120"/>

    </Grid>
</Window>
