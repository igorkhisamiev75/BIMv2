<Window x:Class="RenameSheetsWPF.ViewWPF"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RenameSheetsWPF"              
             mc:Ignorable="d" 
             Title="RenameSheets"
             Height="1000" Width="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.7*"/>
            <ColumnDefinition Width="0.1*"/>
        </Grid.ColumnDefinitions>
        <Button Content="OK" 
                HorizontalAlignment="Center" 
                Margin="0,10,0,0" 
                VerticalAlignment="Top" 
                Width="75" Height="21" 
                Grid.Column="1" Click="Button_Click"/>
        <Button Content="CANCEL" 
                HorizontalAlignment="Center" 
                Margin="0,36,0,0" 
                VerticalAlignment="Top" Width="75" 
                Grid.Column="1" Height="21" Click="Button_Click_1"/>
        <ListBox 
            Name="ListBox"
            HorizontalContentAlignment="Stretch"
            HorizontalAlignment="Stretch" 
            Margin="10,10,10,6650" 
            VerticalAlignment="Stretch" 
            SelectionMode="Extended"
            />
        <DataGrid
            x:Name="sheetGreed"
            AutoGenerateColumns="False"
            HorizontalGridLinesBrush="DarkGray"
            RowBackground="LightGray"
            AlternatingRowBackground="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Стадия"  Binding="{Binding stadiy, Mode=TwoWay}"/>
                <DataGridTextColumn Header="Альбом" Binding="{Binding albom, Mode=TwoWay}" />
                <DataGridTextColumn Header="Номер листа"  Binding="{Binding numberSheet, Mode=TwoWay}"/>
                <DataGridTextColumn Header="Имя листа" Binding="{Binding nameSheet, Mode=TwoWay}" />

            </DataGrid.Columns>
        </DataGrid>
        <Label
            Grid.Column="1" 
            Content="Префикс" 
            HorizontalAlignment="Left" 
            Margin="15,116,0,0" 
            VerticalAlignment="Top"/>
        <TextBox 
            Grid.Column="1" 
            HorizontalAlignment="Center" 
            Margin="0,147,0,0" 
            TextWrapping="Wrap" 
            Text="-" 
            VerticalAlignment="Top" 
            Width="120"/>

    </Grid>
</Window>
