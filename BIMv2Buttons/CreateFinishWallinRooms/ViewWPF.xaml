<Window x:Class="BIMv2Buttons.CreateFinishWallinRooms.ViewWPF"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BIMv2Buttons.CreateFinishWallinRooms"
             mc:Ignorable="d" 
             Title="Отдедка помещений - Cтены"
             Height="800" Width="600">
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0.3*"/>
        </Grid.ColumnDefinitions>
        <ListBox 
            Name="ListBox"
            Grid.Column="0"
            Grid.RowSpan="3"
            HorizontalContentAlignment="Stretch"
            HorizontalAlignment="Stretch" 
            Margin="10,20,10,10" 
            VerticalAlignment="Stretch" 
            SelectionMode="Multiple">
            <!--ItemsSource="{Binding Items}"-->

            <!--<ListBox.Template>
                <ControlTemplate>
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" Height="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.1*"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0">*</Label>
                            <Label Grid.Column="1">Имя помещения</Label>
                        </Grid>
                        <ItemsPresenter></ItemsPresenter>
                    </DockPanel>
                </ControlTemplate>
            </ListBox.Template>-->

            <!--<ListBox.Resources>
                <Style TargetType="ListBoxItem">
                    <Setter Property="OverridesDefaultStyle" Value="true" />
                    <Setter Property="SnapsToDevicePixels" Value="true" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <CheckBox Margin="5,2"
                                          IsChecked="{TemplateBinding IsSelected}">
                                    <ContentPresenter />
                                </CheckBox>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.Resources>-->

        </ListBox>

        <Button x:Name="finish1" 
                Height="65" 
                Grid.Column="1"
                Grid.Row="1"
                HorizontalAlignment="Stretch" 
                Margin="10,10,10,10" 
                VerticalAlignment="Top" 
                Click="finish1_Click">
            <Button.Content>
                <TextBlock Text="Выбрать помещение на плане" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center"/>
            </Button.Content>
        </Button>

        <Button Name="finishAll" 
                Grid.Column="1"
                Grid.Row="0"
                Margin="10,20,10,10" 
                VerticalAlignment="Top" 
                Click="finishAll_Click">
            <Button.Content>
                <TextBlock Text="Отделка через список помещений" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center"/>
            </Button.Content>
        </Button>
        <Button Name="finishDel"
                Grid.Column="1"
                Grid.Row="2"  
                Margin="10,10,10,10" 
                VerticalAlignment="Top" 
                Click="finishDel_Click">
            <Button.Content>
                <TextBlock Text="Удалить отделку в выбранном помещении на плане" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center"/>
            </Button.Content>
        </Button>
        <Button Name="cansel" 
                Height="65" 
                Grid.Column="1"
                Grid.Row="4" 
                Margin="10,10,10,10"                 
                VerticalAlignment="Bottom" 
                Click="cansel_Click" 
                IsCancel="True">
            <Button.Content>
                <TextBlock Text="Отмена" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center"/>
            </Button.Content>
        </Button>
        <ComboBox 
            Name="ComboBox" 
            Grid.Column="0"
            Grid.Row="3"
            HorizontalAlignment="Left" 
            VerticalAlignment="Top"
            Margin="10,40,10,10"
            Width="195" 
            Height="28"/>
        <ComboBox 
            Name="ComboBoxLevel"
            HorizontalAlignment="Right" 
            Margin="240,40,10,0" 
                  Grid.Row="3" 
                  VerticalAlignment="Top" 
                  Width="188" 
                  Height="28"/>
        
        <Label 
            Grid.Column="0"
            Grid.Row="3"
            VerticalAlignment="Top" 
            Margin="10,10,0,0"
            Content="Выбрать тип стен для отделки" 
            HorizontalAlignment="Left"          
            Width="221"
            FontSize="12" 
            FontWeight="Bold"/>
        <Label 
            Grid.Column="0"
            Grid.Row="3"
            VerticalAlignment="Top" 
            Margin="0,10,10,0"
            Content="Выбрать этаж" 
            HorizontalAlignment="Right"          
            Width="94"
            FontSize="12" 
            FontWeight="Bold"/>
        <CheckBox x:Name="chekRoomBoarding"
                  IsChecked="True"
                  Grid.Column="0" 
                  Grid.Row="3" 
                  HorizontalAlignment="Left" 
                  Margin="10,85,0,0" 
                  VerticalAlignment="Top">
            <CheckBox.Content>
                <TextBlock Text="Граница помещения"
                           TextWrapping="Wrap" 
                           TextAlignment="Center"/>
            </CheckBox.Content>
        </CheckBox>
        <Border BorderBrush="#FF787070" 
                BorderThickness="1" 
                Grid.Row="3"/>
        <Border BorderBrush="#FF787070" 
                BorderThickness="1" 
                Grid.RowSpan="3"/>
        <Label Content="Список имён помещений" 
               HorizontalAlignment="Left" 
               Margin="10,0,0,0" 
               Grid.Row="0" 
               VerticalAlignment="Top"
               FontSize="12" 
               FontWeight="Bold"/>

    </Grid>
</Window>
