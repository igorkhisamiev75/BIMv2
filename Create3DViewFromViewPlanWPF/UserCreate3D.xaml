<Window x:Class="Create3DViewFromViewPlanWPF.UserCreate3D"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Create3DViewFromViewPlanWPF"
             Title="Create 3D View for floors"
             Height="560" Width="640">

    <Grid>
        <RadioButton Content="RadioButton" HorizontalAlignment="Left" Margin="13,507,0,0" VerticalAlignment="Top"/>
        <DataGrid HorizontalAlignment="Left" 
                  AutoGenerateColumns="True"
                  x:Name="DataGrid"
                  Height="436" 
                  Margin="10,10,0,0" 
                  VerticalAlignment="Top" 
                  Width="335">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Plans" 
                                    x:Name="AllView"
                                    Binding="{Binding m_allViews}" 
                                    ClipboardContentBinding="{x:Null}"/>
                <DataGridCheckBoxColumn Header="Crete 3D View"
                                        Binding="{x:Null}" 
                                        ClipboardContentBinding="{x:Null}"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="OK" HorizontalAlignment="Left" Margin="404,17,0,0" VerticalAlignment="Top" Width="162" Height="44"/>
        <Button Content="EXIT" HorizontalAlignment="Left" Margin="404,84,0,0" VerticalAlignment="Top" Width="162" Height="46" Click="Button_Click"/>
        <RadioButton Content="RadioButton" HorizontalAlignment="Left" Margin="132,507,0,0" VerticalAlignment="Top"/>
        <DataGrid HorizontalAlignment="Left" 
                  x:Name="DataGrid2"
                  Height="335" 
                  Margin="379,152,0,0" 
                  VerticalAlignment="Top" 
                  Width="106"/>
        <ListBox HorizontalAlignment="Left" 
                 x:Name="ListBox"
                 Height="335" Margin="502,152,0,0" 
                 VerticalAlignment="Top"
                 Width="122"/>

    </Grid>
</Window>
