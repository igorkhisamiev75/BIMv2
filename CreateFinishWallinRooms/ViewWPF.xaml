<Window x:Class="CreateFinishWallinRooms.ViewWPF"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CreateFinishWallinRooms"
             mc:Ignorable="d" 
             Title="Отдедка помещений - Cтены"
             Height="842" 
        Width="654"
        WindowStyle="None"
        ResizeMode="CanResize"
        >
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FF647F99"/>
            <GradientStop Color="#FFE2E2E2" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="0.5*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0.3*"/>
        </Grid.ColumnDefinitions>
        <ListBox 
            Name="ListBox"
            Grid.Column="0"
            Grid.RowSpan="3"
            HorizontalContentAlignment="Stretch"
            HorizontalAlignment="Stretch" 
            Margin="10,20,10,10" 
            VerticalAlignment="Stretch" 
            SelectionMode="Multiple">

        </ListBox>

        <Button x:Name="finish1" 
                Height="65" 
                Grid.Column="1"
                Grid.Row="0"
                HorizontalAlignment="Stretch" 
                Margin="10,65,10,10" 
                VerticalAlignment="Top" 
                Click="finish1_Click">
            <Button.Content>
                <TextBlock Text="Выбрать помещение на плане" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center"/>
            </Button.Content>
        </Button>

        <Button x:Name="finishFloorInOneRoom" 
                Height="65" 
                Grid.Column="1"
                Grid.Row="1"
                HorizontalAlignment="Stretch" 
                Margin="10,65,10,10" 
                VerticalAlignment="Top" 
                Click="finishFloorInOneRoom_Click" 
               >
            <Button.Content>
                <TextBlock Text="Выбрать помещение на плане" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center"/>
            </Button.Content>
        </Button>
        
        

        <Button Name="finishAll" 
                Grid.Column="1"
                Grid.Row="0"
                Margin="10,25,10,10" 
                VerticalAlignment="Top" 
                Click="finishAll_Click">
            <Button.Content>
                <TextBlock Text="Стены через список помещений" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center"/>
            </Button.Content>
        </Button>
        <Button Name="floorAll" 
                Grid.Column="1"
                Grid.Row="1"
                Margin="10,25,10,10" 
                VerticalAlignment="Top" 
                Click="floorAll_Click"                  
                >
            <Button.Content>
                <TextBlock Text="Полы через список помещений" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center"/>
            </Button.Content>
        </Button>
        <Button Name="finishDel"
                Grid.Column="1"
                Grid.Row="2"  
                Margin="10,55,10,10" 
                VerticalAlignment="Top" 
                Click="finishDel_Click">
            <Button.Content>
                <TextBlock Text="Выбрать все помещения" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center"/>
            </Button.Content>
        </Button>
        <Button Name="cansel" 
                Grid.Column="1"
                Grid.Row="4" 
                Margin="10,10,10,10"                 
                VerticalAlignment="Stretch" 
                Click="cansel_Click" 
                IsCancel="True">
            <Button.Content>
                <TextBlock Text="Отмена" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center"/>
            </Button.Content>
        </Button>
        <ComboBox 
            Name="ComboBox" 
            Grid.Column="0"
            Grid.Row="3"
            HorizontalAlignment="Left" 
            VerticalAlignment="Top"
            Margin="10,40,10,10"
            Width="195" 
            Height="28"/>
        <ComboBox 
            Name="ComboBoxFloor" 
            Grid.Column="0"
            Grid.Row="3"
            HorizontalAlignment="Left" 
            VerticalAlignment="Top"
            Margin="10,100,10,10"
            Width="195" 
            Height="28"/>
        <ComboBox 
            Name="ComboBoxLevel"
            HorizontalAlignment="Right" 
            Margin="240,40,10,0" 
                  Grid.Row="3" 
                  VerticalAlignment="Top" 
                  Width="188" 
                  Height="28"/>
        <Label 
            Grid.Column="0"
            Grid.Row="3"
            VerticalAlignment="Top" 
            Margin="10,10,0,0"
            Content="Выбрать тип стен для отделки" 
            HorizontalAlignment="Left"          
            Width="221"
            FontSize="12" 
            FontWeight="Bold"/>
        <Label 
            Grid.Column="0"
            Grid.Row="3"
            VerticalAlignment="Top" 
            Margin="10,70,0,0"
            Content="Выбрать тип полов для отделки" 
            HorizontalAlignment="Left"          
            Width="221"
            FontSize="12" 
            FontWeight="Bold"/>
        <Label 
            Grid.Column="0"
            Grid.Row="3"
            VerticalAlignment="Top" 
            Margin="0,10,10,0"
            Content="Выбрать этаж" 
            HorizontalAlignment="Right"          
            Width="94"
            FontSize="12" 
            FontWeight="Bold"/>
        <Label 
            Grid.Column="0"
            Grid.Row="3"
            VerticalAlignment="Bottom" 
            Margin="10,10,10,10"
            Content="Задать высоту отделки, в мм" 
            HorizontalAlignment="Left"          
            Width="221"
            FontSize="12" 
            FontWeight="Bold"/>
        <TextBox
                Grid.Column="0"
                Grid.Row="3"
                Name="heightWallNotRooms"
                VerticalAlignment="Bottom"
                TextWrapping="Wrap"
            HorizontalAlignment="Left"
                Width="100"
                Height="22"
                FontSize="12" 
                Text="" 
                Margin="203,10,10,15"/>

        <CheckBox x:Name="chekRoomBoarding"
                  IsChecked="False"
                  Grid.Column="0" 
                  Grid.Row="3" 
                  HorizontalAlignment="Right" 
                  Margin="0,85,10,10" 
                  VerticalAlignment="Top">
            <CheckBox.Content>
                <TextBlock Text="Граница помещения"
                           TextWrapping="Wrap" 
                           TextAlignment="Center"
                           />
            </CheckBox.Content>
        </CheckBox>
        <Border BorderBrush="#FF787070" 
                BorderThickness="1" 
                Grid.Row="3"
                Grid.RowSpan="2">

        </Border>
        <Border BorderBrush="#FF787070" 
                BorderThickness="1" 
                Grid.RowSpan="3"/>
        <Border BorderBrush="#FF787070" 
                BorderThickness="1" 
                Grid.RowSpan="2"
                Grid.Column="1"/>
        <Border BorderBrush="#FF787070" 
                BorderThickness="1" 
                Grid.RowSpan="1"
                Grid.Column="1"/>

        <Label Content="Список имён помещений" 
               HorizontalAlignment="Left" 
               Margin="10,0,0,0" 
               Grid.Row="0" 
               VerticalAlignment="Top"
               FontSize="12" 
               FontWeight="Bold"/>
        <Label Content="Стены" 
               HorizontalAlignment="Left" 
               Margin="10,0,0,0" 
               Grid.Row="0"
               Grid.Column="1"
               VerticalAlignment="Top"
               FontSize="14" 
               FontWeight="Bold"/>
        <Label Content="Полы/Перекрытия" 
               HorizontalAlignment="Left" 
               Margin="10,0,0,0" 
               Grid.Row="1"
               Grid.Column="1"
               VerticalAlignment="Top"
               FontSize="14" 
               FontWeight="Bold"/>


    </Grid>
</Window>
