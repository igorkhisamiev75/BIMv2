<Window x:Class="CreateFinishWallinRooms.ViewWPF"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CreateFinishWallinRooms"
             mc:Ignorable="d" 
             Title="Отдедка помещений - Cтены"
             Height="800" Width="500">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0.3*"/>
        </Grid.ColumnDefinitions>
        <ListBox 
            Name="ListBox"
            Grid.Column="0"
            HorizontalContentAlignment="Stretch"
            HorizontalAlignment="Stretch" 
            Margin="10,10,10,10" 
            VerticalAlignment="Stretch" 
            SelectionMode="Multiple"
            ItemsSource="{Binding Items}">

            <ListBox.Resources>
                <Style TargetType="ListBoxItem">
                    <Setter Property="OverridesDefaultStyle" Value="true" />
                    <Setter Property="SnapsToDevicePixels" Value="true" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <CheckBox Margin="5,2"
                                          IsChecked="{TemplateBinding IsSelected}">
                                    <ContentPresenter />
                                </CheckBox>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.Resources>
          
            

        </ListBox>
         
        

        <Button Name="finish1" 
                Height="65" 
                Grid.Column="1"
                HorizontalAlignment="Stretch" 
                Margin="10,10,10,10" 
                VerticalAlignment="Top" Click="finish1_Click">
            <Button.Content>
                <TextBlock Text="Выбрать помещение на плане" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center"/>
            </Button.Content>
        </Button>
        
        <Button Name="finishAll" 
                Grid.Column="1" 
                Margin="10,159,10,533" Click="finishAll_Click">
            <Button.Content>
                <TextBlock Text="Отделка через список помещений" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center"/>
            </Button.Content>
        </Button>
        <Button Name="finishDel"
                Grid.Column="1" 
                Margin="10,314,10,376" Click="finishDel_Click">
            <Button.Content>
                <TextBlock Text="Удалить отделку в выбранном помещении на плане" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center"/>
            </Button.Content>
        </Button>
        <Button Name="cansel" 
                Height="65" 
                Grid.Column="1" 
                Margin="10,0,10,10"
                VerticalAlignment="Bottom" Click="cansel_Click">
            <Button.Content>
                <TextBlock Text="Отмена" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center"/>
            </Button.Content>
        </Button>
        <ComboBox Grid.Column="1" 
                  HorizontalAlignment="Center" 
                  Margin="0,484,0,0" 
                  VerticalAlignment="Top" 
                  Width="95" 
                  Height="28"/>

    </Grid>
</Window>
