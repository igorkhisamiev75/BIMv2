<Window x:Class="CreateFinishWallinRooms.ViewWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:CreateFinishWallinRooms"
        mc:Ignorable="d" 
        Title="Отделка помещений - надстройка 2BIM.RU"
        Height="892"
        Width="700"
        ResizeMode="CanResize"
        MinHeight="700"
        MinWidth="600">

    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFD44519"/>
            <GradientStop Color="#FFE2E2E2" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- ========== БЛОК 1: Выбор этажа ========== -->
        <GroupBox Header="1. Выбор этажа" 
                  Grid.Row="0" 
                  Grid.Column="0" 
                  Grid.ColumnSpan="2"
                  Margin="0,0,0,10"
                  Padding="5"
                  FontWeight="Bold">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Выбрать этаж:" 
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Margin="10,5,10,5"
                       FontWeight="Normal"/>
                <ComboBox Name="ComboBoxLevel"
                          Grid.Column="1"
                          HorizontalAlignment="Left"
                          Width="200"
                          Height="28"
                          Margin="10,5,10,5"
                          FontWeight="Normal"/>
            </Grid>
        </GroupBox>

        <!-- ========== БЛОК 2: Задание высот и смещений ========== -->
        <GroupBox Header="2. Параметры отделки" 
                  Grid.Row="1" 
                  Grid.Column="0" 
                  Grid.ColumnSpan="2"
                  Margin="0,0,0,10"
                  Padding="5"
                  FontWeight="Bold">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Высота отделки -->
                <Border Grid.Row="0" Grid.Column="0" Margin="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Высота отделки (мм):" 
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               FontWeight="Normal"/>
                        <TextBox Name="heightWallNotRooms"
                                 Grid.Column="1"
                                 Width="100"
                                 Height="22"
                                 FontSize="12"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Left"
                                 Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Смещение отделки -->
                <Border Grid.Row="0" Grid.Column="1" Margin="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Смещение отделки (мм):" 
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               FontWeight="Normal"/>
                        <TextBox Name="ofsetWall"
                                 Grid.Column="1"
                                 Width="100"
                                 Height="22"
                                 FontSize="12"
                                 Text="0"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Left"
                                 Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Граница помещения -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="5">
                    <CheckBox x:Name="chekRoomBoarding"
                              IsChecked="False"
                              VerticalAlignment="Center"
                              Margin="10,5,0,5">
                        <CheckBox.Content>
                            <TextBlock Text="Учитывать границу помещения"
                                       FontWeight="Normal"/>
                        </CheckBox.Content>
                    </CheckBox>
                </Border>
            </Grid>
        </GroupBox>

        <!-- ========== БЛОК 3: Выбор типа отделки ========== -->
        <GroupBox Header="3. Выбор типа отделки" 
                  Grid.Row="2" 
                  Grid.Column="0"
                  Margin="0,0,10,10"
                  Padding="5"
                  FontWeight="Bold">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Стены -->
                <Border Grid.Row="0" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label Content="Стены" 
                               FontWeight="Bold"
                               FontSize="13"
                               Foreground="#FFD44519"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,5,0,5">
                            <ComboBox Name="ComboBox"
                                      Width="180"
                                      Height="28"
                                      Margin="0,0,10,0"/>
                            <Button Name="finishAll" 
                                    Content="Отделка через список"
                                    Padding="10,5"
                                    Click="finishAll_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Полы -->
                <Border Grid.Row="1" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label Content="Полы" 
                               FontWeight="Bold"
                               FontSize="13"
                               Foreground="#FFD44519"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,5,0,5">
                            <ComboBox Name="ComboBoxFloor"
                                      Width="180"
                                      Height="28"
                                      Margin="0,0,10,0"/>
                            <Button Name="floorAll" 
                                    Content="Отделка через список"
                                    Padding="10,5"
                                    Click="floorAll_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Потолки -->
                <Border Grid.Row="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label Content="Потолки" 
                               FontWeight="Bold"
                               FontSize="13"
                               Foreground="#FFD44519"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,5,0,5">
                            <ComboBox Name="ComboBoxCeiling"
                                      Width="180"
                                      Height="28"
                                      Margin="0,0,10,0"/>
                            <Button Name="finishAllCeiling" 
                                    Content="Отделка через список"
                                    Padding="10,5"
                                    Click="finishAllCeiling_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </GroupBox>

        <!-- ========== БЛОК 4: Действия Стены-Полы-Потолки ========== -->
        <GroupBox Header="4. Действия с выбранными помещениями" 
                  Grid.Row="2" 
                  Grid.Column="1"
                  Margin="0,0,0,10"
                  Padding="5"
                  FontWeight="Bold">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button x:Name="finish1" 
                        Grid.Row="0"
                        Height="50"
                        Margin="0,5,0,5"
                        Click="finish1_Click">
                    <Button.Content>
                        <TextBlock Text="Отделка стен (выбор на плане)" 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center"/>
                    </Button.Content>
                </Button>

                <Button x:Name="finishFloorInOneRoom" 
                        Grid.Row="1"
                        Height="50"
                        Margin="0,5,0,5"
                        Click="finishFloorInOneRoom_Click">
                    <Button.Content>
                        <TextBlock Text="Отделка полов (выбор на плане)" 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center"/>
                    </Button.Content>
                </Button>

                <Button x:Name="finishCeiling" 
                        Grid.Row="2"
                        Height="50"
                        Margin="0,5,0,5"
                        Click="finishCeiling_Click">
                    <Button.Content>
                        <TextBlock Text="Отделка потолков (выбор на плане)" 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center"/>
                    </Button.Content>
                </Button>

                <Button Name="finishDel"
                        Grid.Row="3"
                        Height="40"
                        Margin="0,10,0,5"
                        Click="finishDel_Click">
                    <Button.Content>
                        <TextBlock Text="Выбрать все помещения" 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center"/>
                    </Button.Content>
                </Button>
            </Grid>
        </GroupBox>

        <!-- ========== СПИСОК ПОМЕЩЕНИЙ ========== -->
        <GroupBox Header="Список помещений" 
                  Grid.Row="3" 
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  Margin="0,0,0,10"
                  Padding="5"
                  FontWeight="Bold">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Content="Список имён помещений (Ctrl + клик - множественный выбор)"
                       Grid.Row="0"
                       FontWeight="Normal"
                       FontSize="11"
                       Margin="5,0,0,5"/>

                <ListBox Name="ListBox"
                         Grid.Row="1"
                         HorizontalContentAlignment="Stretch"
                         HorizontalAlignment="Stretch" 
                         VerticalAlignment="Stretch" 
                         SelectionMode="Multiple"
                         Margin="5"/>
            </Grid>
        </GroupBox>

        <!-- ========== КНОПКА ОТМЕНЫ ========== -->
        <Button Name="cansel" 
                Grid.Row="4"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Height="35"
                Width="100"
                HorizontalAlignment="Right"
                Margin="0,0,0,0"
                Click="cansel_Click" 
                IsCancel="True">
            <Button.Content>
                <TextBlock Text="Отмена" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center"/>
            </Button.Content>
        </Button>

    </Grid>
</Window>